# Minecraft Bot (L1 core, protocol 775) — 安装到 /etc/systemd/system/minecraft-bot.service
# 部署: sudo cp systemd/minecraft-bot.service /etc/systemd/system/ && sudo systemctl daemon-reload
[Unit]
Description=Minecraft Bot (L1 core, protocol 775)
After=network-online.target minecraft-server.service
Wants=network-online.target
# StartLimit* 属于 [Unit] 段（写在 [Service] 会被 systemd 忽略并告警）
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/minecraft-bot
EnvironmentFile=-/etc/minecraft-bot/env
ExecStart=/usr/bin/node src/index.js --config /etc/minecraft-bot/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
CPUWeight=30
MemoryHigh=384M
MemoryMax=768M
TasksMax=128
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/minecraft-bot /etc/minecraft-bot /opt/minecraft-bot/logs
# 日志目录（M3 修复：默认 log.dir 在 ProtectSystem=strict 下必须显式可写，
# 否则 pino-roll 以 EROFS 静默失败。配置中建议 log.dir=/var/lib/minecraft-bot/logs）
LogsDirectory=minecraft-bot
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
