{
  "_comment": "生产配置示例。复制为 config/config.json 使用（该文件已被 gitignore）。环境变量 MCBOT_* 可覆盖以下任意项。",
  "mcVersion": "26.1.2",
  "host": "localhost",
  "port": 25565,
  "username": "mcbot",
  "auth": "offline",
  "ops": [
    "steve"
  ],
  "tasks": [
    {
      "id": "mine-iron",
      "type": "mine",
      "enabled": true,
      "options": {
        "blockTypes": [
          "iron_ore",
          "deepslate_iron_ore"
        ],
        "radius": 32,
        "maxBlocks": 64,
        "chestLocations": [
          {
            "x": 0,
            "y": 0,
            "z": 0
          }
        ],
        "area": {
          "x1": -50,
          "y1": -60,
          "z1": -50,
          "x2": 50,
          "y2": 0,
          "z2": 50
        }
      }
    },
    {
      "id": "night-fish",
      "type": "fish",
      "enabled": true,
      "schedule": "0 20 * * *",
      "options": {
        "durationMinutes": 60,
        "stopWhenInventoryFull": true
      }
    },
    {
      "id": "afk-main",
      "type": "afk",
      "enabled": true,
      "options": {
        "intervalMinutes": 5
      }
    },
    {
      "id": "wheat-farm",
      "type": "farm",
      "enabled": false,
      "options": {
        "area": {
          "x1": -10,
          "y1": 64,
          "z1": -10,
          "x2": 10,
          "y2": 64,
          "z2": 10
        },
        "cropTypes": [
          "wheat"
        ],
        "maxCycles": 3
      },
      "_comment": "默认巡逻：区域空闲等待（stopWhenIdle: true 才完成）"
    },
    {
      "id": "wood-chop",
      "type": "chop",
      "enabled": false,
      "options": {
        "area": {
          "x1": -30,
          "y1": 60,
          "z1": -30,
          "x2": 30,
          "y2": 90,
          "z2": 30
        }
      },
      "_comment": "默认巡逻：无树等待（stopWhenDone: true 才完成）"
    },
    {
      "id": "guard-base",
      "type": "combat",
      "enabled": false,
      "options": {
        "area": {
          "x1": -50,
          "y1": -64,
          "z1": -50,
          "x2": 50,
          "y2": 100,
          "z2": 50
        },
        "maxTargets": 5
      },
      "_comment": "combat 默认巡逻：无怪时持续等待（stopWhenNoTargets 默认 false）；一次性清理配 stopWhenNoTargets: true"
    },
    {
      "id": "breed-cows",
      "type": "breed",
      "enabled": false,
      "options": {
        "area": {
          "x1": -15,
          "y1": 60,
          "z1": -15,
          "x2": 15,
          "y2": 70,
          "z2": 15
        },
        "animalTypes": [
          "cow"
        ],
        "foodItem": "wheat",
        "maxBreedings": 2
      },
      "_comment": "默认巡逻：无动物等待（stopWhenNoAnimals: true 才完成）"
    }
  ],
  "mineflayerPlugins": {
    "follow": true,
    "_comment": "可选插件 follow：显式 true 才装载（!follow 命令依赖）。注意：插件在连接期装载，改此项需 nssm restart 生效（热重载不重装插件）。其余插件（pathfinder/collectBlock/autoEat/armorManager）默认启用，无需列出"
  },
  "chat": {
    "maxLength": 250,
    "commandCooldownMs": 750
  },
  "http": {
    "enabled": false,
    "port": 8123,
    "_comment": "只读状态端点（/health /metrics，curl 即可）：只绑 127.0.0.1 默认关；暴露到局域网需自行加防火墙/反代"
  },
  "scheduleTimezone": "Asia/Shanghai",
  "l2": {
    "enabled": false,
    "provider": "auto",
    "model": "claude-sonnet-5",
    "cloudBaseUrl": "https://api.anthropic.com/v1/messages",
    "cloudApiKeyEnv": "ANTHROPIC_API_KEY",
    "ollamaUrl": "http://127.0.0.1:11434",
    "ollamaModel": "qwen3.5:4b",
    "maxSteps": 5,
    "cooldownMs": 5000,
    "cloudTimeoutMs": 60000,
    "ollamaTimeoutMs": 60000,
    "maxTokens": 1024,
    "_comment": "API key 只从环境变量 cloudApiKeyEnv 指定的变量读取（如 ANTHROPIC_API_KEY），绝不写进配置文件"
  }
}
