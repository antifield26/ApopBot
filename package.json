{
  "name": "minecraft-bot",
  "private": true,
  "type": "module",
  "version": "0.2.0",
  "description": "Production Minecraft bot for PaperMC 26.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"tests/*.test.mjs\"",
    "check:compat": "node scripts/check-compat.mjs",
    "smoke": "node scripts/smoke.mjs",
    "migrate-upstream": "node scripts/migrate-upstream.mjs",
    "release": "node scripts/release.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "mineflayer": "^4.37.1",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-armor-manager": "^2.0.1",
    "minecraft-data": "^3.113.0",
    "pino": "^9.5.0",
    "pino-roll": "^2.0.0",
    "croner": "^9.0.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "minecraft-protocol": "^1.66.2",
    "patch-package": "^8.0.0",
    "pino-pretty": "^11.0.0"
  },
  "overrides": {
    "minecraft-data": "^3.113.0",
    "prismarine-chunk": "1.41.0",
    "prismarine-physics": "1.11.1"
  }
}
