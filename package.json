{
  "name": "minecraft-bot",
  "private": true,
  "type": "module",
  "version": "1.5.1",
  "description": "Production Minecraft bot for PaperMC 26.1.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pretest": "npm run check:compat",
    "test": "node --test \"tests/*.test.mjs\"",
    "lint": "eslint src tests scripts eslint.config.js",
    "check:compat": "node scripts/check-compat.mjs",
    "smoke": "node scripts/smoke.mjs",
    "migrate-upstream": "node scripts/migrate-upstream.mjs",
    "release": "node scripts/release.mjs",
    "postinstall": "patch-package",
    "typecheck": "tsc -p tsconfig.json",
    "test:coverage": "node scripts/test-coverage.mjs"
  },
  "dependencies": {
    "croner": "^9.0.0",
    "minecraft-data": "^3.113.0",
    "mineflayer": "^4.37.1",
    "mineflayer-armor-manager": "^2.0.1",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "patch-package": "^8.0.1",
    "pino": "^9.5.0",
    "pino-roll": "^2.0.0",
    "vec3": "^0.1.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "minecraft-protocol": "^1.66.2",
    "pino-pretty": "^11.0.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minecraft-data": "^3.113.0",
    "prismarine-chunk": "1.41.0",
    "prismarine-physics": "1.11.1"
  }
}
